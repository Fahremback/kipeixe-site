{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kipeixe-orders",
  "main": "src/app.mjs",
  "compatibility_date": "2026-11-05",
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "routes": [
    {
      "pattern": "api.restaurantekipeixe.com.br",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "PAYMENTS_ENABLED": "true",
    "DELIVERY_ENABLED": "false",
    "DELIVERY_FEE_CENTS": "0",
    "UBER_DIRECT_ENABLED": "false",
    "IFOOD_SHIPPING_ENABLED": "false",
    "UBER_PICKUP_ADDRESS": "Av. João Ricieri Maran, 1417, Três Lagoas, Foz do Iguaçu - PR, 85862-425, Brasil",
    "UBER_PICKUP_PHONE": "+554535772363"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kipeixe-orders",
      "database_id": "46297b1a-a948-4531-ba1c-493ece612081",
      "migrations_dir": "migrations"
    }
  ]
}
