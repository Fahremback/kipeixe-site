{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kipeixe-orders",
  "main": "src/app.mjs",
  "compatibility_date": "2026-11-05",
  "routes": [
    {
      "pattern": "api.restaurantekipeixe.com.br",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "PAYMENTS_ENABLED": "true",
    "DELIVERY_ENABLED": "false",
    "DELIVERY_FEE_CENTS": "0"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kipeixe-orders",
      "database_id": "46297b1a-a948-4531-ba1c-493ece612081",
      "migrations_dir": "migrations"
    }
  ]
}
